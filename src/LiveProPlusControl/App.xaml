<Application x:Class="LiveProPlusControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LiveProPlusControl"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- Paleta tomada de la app JBL Headphones (colors.xml) -->
        <Color x:Key="AccentColor">#FF5901</Color>
        <SolidColorBrush x:Key="Accent" Color="#FF5901"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF6F28"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FFF0E6"/>
        <SolidColorBrush x:Key="Text1" Color="#282F36"/>
        <SolidColorBrush x:Key="Text2" Color="#617087"/>
        <SolidColorBrush x:Key="Text3" Color="#A2ABBA"/>
        <SolidColorBrush x:Key="IconIdle" Color="#4C596B"/>
        <SolidColorBrush x:Key="Bg" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Subtle" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="SubtleHover" Color="#E7EAEE"/>
        <SolidColorBrush x:Key="Line" Color="#E5EAEF"/>
        <SolidColorBrush x:Key="Good" Color="#76C411"/>
        <SolidColorBrush x:Key="Warn" Color="#FF9420"/>
        <SolidColorBrush x:Key="Bad" Color="#F46767"/>

        <!-- Convertidores -->
        <local:EnumToBoolConverter x:Key="EnumToBool"/>
        <local:IndexToBoolConverter x:Key="IndexToBool"/>
        <local:PercentTextConverter x:Key="PctText"/>
        <local:PercentValueConverter x:Key="PctValue"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <local:BatteryBrushConverter x:Key="BatteryBrush" Good="{StaticResource Good}" Warn="{StaticResource Warn}" Low="{StaticResource Bad}"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        <local:IsTrueConverter x:Key="IsTrue"/>
        <local:NotTrueToVisibilityConverter x:Key="NotTrueToVis"/>
        <local:StateBrushConverter x:Key="StateBrush" Connected="{StaticResource Good}" Searching="{StaticResource Warn}" Disconnected="{StaticResource Text3}"/>

        <!-- Logotipo JBL (res/drawable/svg_jbl_logo.xml de la app, viewport 47x27) -->
